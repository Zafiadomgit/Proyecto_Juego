# Copia este archivo a .env.production y rellena los valores reales (NO subas .env.production a git).
# En GitHub Actions se configuran como "Repository variables" con el mismo nombre.

# AdMob → Apps → Gemzy Blocks → Unidades de anuncios
VITE_ADMOB_REWARDED_ID=
VITE_ADMOB_INTERSTITIAL_ID=

# URL de la función de verificación de compras (Supabase Edge Function verify-purchase)
VITE_BILLING_VALIDATOR_URL=https://TU-PROYECTO.supabase.co/functions/v1/verify-purchase
VITE_BILLING_VALIDATOR_KEY=

# URL pública de tu política de privacidad (obligatoria en Play Console)
VITE_PRIVACY_POLICY_URL=
